    <string name="s_client_mute">클라이언트(음소거)</string>
    <string name="s_connects_the_node_to_a">인터넷 게이트웨이로 쓸 수 있도록 노드를 Wi-Fi 네트워크에 연결합니다. ESP32 보드에서는 Wi-Fi를 켜면 Bluetooth가 꺼집니다.</string>
    <string name="s_debug_log">디버그 로그</string>
    <string name="s_distances_and_altitudes_on_the">노드 화면에 표시되는 거리와 고도의 단위입니다.</string>
    <string name="s_everything">전체</string>
    <string name="s_everything_without_reading">전체(읽지 않고)</string>
