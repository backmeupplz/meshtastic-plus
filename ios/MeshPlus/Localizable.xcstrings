        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "노드 화면에 시간을 13:00 대신 오후 1:00 형식으로 표시합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
