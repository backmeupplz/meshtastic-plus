    "Blocking hides everything from that person on this phone, including their notifications." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يؤدي الحظر إلى إخفاء كل ما يصل من هذا الشخص على هذا الهاتف، بما في ذلك إشعاراته."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blockieren blendet auf diesem Telefon alles von dieser Person aus, auch ihre Benachrichtigungen."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blocking hides everything from that person on this phone, including their notifications."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al bloquear, se oculta todo lo de esa persona en este móvil, incluidas sus notificaciones."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al bloquear, se oculta todo lo de esa persona en este celular, incluidas sus notificaciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le blocage masque tout ce qui vient de cette personne sur ce téléphone, y compris ses notifications."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ब्लॉक करने से इस फ़ोन पर उस व्यक्ति की हर चीज़ छिप जाती है, उनकी सूचनाएँ भी।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memblokir akan menyembunyikan semua hal dari orang tersebut di ponsel ini, termasuk notifikasinya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il blocco nasconde tutto ciò che arriva da quella persona su questo telefono, notifiche comprese."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ブロックすると、通知も含めてその人からのものがこのスマートフォンではすべて非表示になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "차단하면 이 휴대폰에서 해당 사용자의 모든 내용이 알림을 포함해 숨겨집니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blokkeren verbergt alles van die persoon op deze telefoon, ook hun meldingen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zablokowanie ukrywa na tym telefonie wszystko od tej osoby, w tym jej powiadomienia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bloquear oculta tudo dessa pessoa neste celular, incluindo as notificações dela."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bloquear oculta tudo dessa pessoa neste telemóvel, incluindo as notificações dela."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Блокировка скрывает на этом телефоне всё от этого человека, включая уведомления."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om du blockerar döljs allt från den personen på den här telefonen, även personens notiser."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การบล็อกจะซ่อนทุกอย่างจากคนนั้นบนโทรศัพท์เครื่องนี้ รวมถึงการแจ้งเตือนจากเขาด้วย"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Engellemek, bu telefonda o kişiden gelen her şeyi, bildirimleri de dahil olmak üzere gizler."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Блокування приховує на цьому телефоні все від цієї людини, зокрема сповіщення."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi chặn, mọi thứ từ người đó sẽ bị ẩn trên điện thoại này, kể cả thông báo của họ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "屏蔽后，此人的所有内容（包括通知）都会在这部手机上隐藏。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "封鎖後，這支手機上會隱藏此人的所有內容，包括通知。"
          }
        }
      }
    },
    "Blocking hides their messages and DMs on this phone and stops their notifications." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يؤدي الحظر إلى إخفاء رسائله ورسائله الخاصة على هذا الهاتف وإيقاف إشعاراته."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blockieren blendet ihre Nachrichten und Direktnachrichten auf diesem Telefon aus und stoppt ihre Benachrichtigungen."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blocking hides their messages and DMs on this phone and stops their notifications."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al bloquear, se ocultan sus mensajes, también los directos, en este móvil y dejas de recibir sus notificaciones."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al bloquear, se ocultan sus mensajes, también los directos, en este celular y dejas de recibir sus notificaciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le blocage masque ses messages publics et privés sur ce téléphone et coupe ses notifications."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ब्लॉक करने से इस फ़ोन पर उनके मैसेज और डायरेक्ट मैसेज छिप जाते हैं और उनकी सूचनाएँ बंद हो जाती हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memblokir akan menyembunyikan pesan dan DM mereka di ponsel ini serta menghentikan notifikasinya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il blocco nasconde i suoi messaggi pubblici e diretti su questo telefono e ne disattiva le notifiche."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ブロックすると、この人のメッセージとDMがこのスマートフォンで非表示になり、通知も届かなくなります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "차단하면 이 휴대폰에서 해당 사용자의 메시지와 DM이 숨겨지고 알림도 오지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blokkeren verbergt hun berichten en privéberichten op deze telefoon en stopt hun meldingen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zablokowanie ukrywa na tym telefonie wiadomości tej osoby, także prywatne, i wyłącza powiadomienia od niej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bloquear oculta todas as mensagens dessa pessoa neste celular, inclusive as diretas, e interrompe as notificações dela."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bloquear oculta todas as mensagens dessa pessoa neste telemóvel, incluindo as diretas, e desativa as notificações dela."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Блокировка скрывает на этом телефоне его сообщения, в том числе личные, и отключает уведомления от него."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om du blockerar döljs personens meddelanden och direktmeddelanden på den här telefonen, och du får inga fler notiser från hen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การบล็อกจะซ่อนข้อความและข้อความส่วนตัวของเขาบนโทรศัพท์เครื่องนี้ และหยุดการแจ้งเตือนจากเขา"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Engellemek, bu telefonda o kişinin mesajlarını ve özel mesajlarını gizler, bildirimlerini durdurur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Блокування приховує на цьому телефоні її повідомлення, зокрема особисті, і вимикає сповіщення від неї."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi chặn, tin nhắn trong phòng và tin nhắn riêng của họ sẽ bị ẩn trên điện thoại này, và bạn sẽ không nhận thông báo từ họ nữa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "屏蔽后，此人的消息和私信会在这部手机上隐藏，也不会再收到其通知。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "封鎖後，這支手機上會隱藏此人的訊息和私訊，也不會再收到其通知。"
          }
        }
      }
    },
