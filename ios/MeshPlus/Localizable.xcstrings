    "Mesh+ isn't allowed to use Bluetooth. Turn it on in Settings → Apps → Mesh+." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يُسمح لـ Mesh+ باستخدام Bluetooth. فعّله من الإعدادات ← التطبيقات ← Mesh+."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mesh+ darf Bluetooth nicht verwenden. Erlaube es unter Einstellungen → Apps → Mesh+."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mesh+ isn't allowed to use Bluetooth. Turn it on in Settings → Apps → Mesh+."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mesh+ no tiene permiso para usar el Bluetooth. Actívalo en Ajustes → Apps → Mesh+."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mesh+ no tiene permiso para usar el Bluetooth. Actívalo en Configuración → Apps → Mesh+."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mesh+ n'est pas autorisé à utiliser le Bluetooth. Activez-le dans Réglages → Apps → Mesh+."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mesh+ को Bluetooth इस्तेमाल करने की अनुमति नहीं है। इसे सेटिंग्ज़ → ऐप्स → Mesh+ में चालू करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mesh+ tidak diizinkan menggunakan Bluetooth. Aktifkan di Pengaturan → App → Mesh+."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mesh+ non è autorizzata a usare il Bluetooth. Attivalo in Impostazioni → App → Mesh+."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mesh+にBluetoothの使用が許可されていません。「設定」→「アプリ」→「Mesh+」でオンにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mesh+에 Bluetooth 사용 권한이 없습니다. 설정 → 앱 → Mesh+에서 켜세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mesh+ mag Bluetooth niet gebruiken. Zet het aan in Instellingen → Apps → Mesh+."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mesh+ nie ma dostępu do Bluetooth. Włącz go w Ustawienia → Aplikacje → Mesh+."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Mesh+ não tem permissão para usar o Bluetooth. Ative em Ajustes → Apps → Mesh+."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
