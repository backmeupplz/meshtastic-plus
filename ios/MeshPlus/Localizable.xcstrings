    "Blinks the node's LED every few seconds to show it's running. Turn off to keep it dark or save a little battery." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يومض مصباح LED في العقدة كل بضع ثوانٍ ليُظهر أنها تعمل. أوقفه لإبقائها مُطفأة الضوء أو لتوفير قليل من البطارية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lässt die LED des Knotens alle paar Sekunden blinken, damit du siehst, dass er läuft. Schalte es aus, damit er dunkel bleibt oder etwas Akku spart."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blinks the node's LED every few seconds to show it's running. Turn off to keep it dark or save a little battery."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hace parpadear el LED del nodo cada pocos segundos para indicar que funciona. Desactívalo para que no se vea o para ahorrar un poco de batería."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hace parpadear el LED del nodo cada pocos segundos para indicar que funciona. Desactívalo para que no se vea o para ahorrar un poco de batería."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fait clignoter la LED du nœud toutes les quelques secondes pour montrer qu'il fonctionne. Désactivez-la pour rester discret ou économiser un peu de batterie."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नोड की LED हर कुछ सेकंड में ब्लिंक करती है, ताकि पता चले कि वह चल रहा है। इसे अंधेरा रखने या थोड़ी बैटरी बचाने के लिए बंद करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mengedipkan LED node setiap beberapa detik untuk menunjukkan bahwa node menyala. Matikan agar tetap gelap atau untuk sedikit menghemat baterai."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fa lampeggiare il LED del nodo ogni pochi secondi per mostrare che è in funzione. Disattivalo per tenerlo spento o risparmiare un po' di batteria."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "動作中であることを示すため、ノードのLEDを数秒ごとに点滅させます。暗いままにしたいときや、バッテリーを少しでも節約したいときはオフにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "노드가 작동 중임을 알리기 위해 몇 초마다 LED를 깜박입니다. 불빛을 끄거나 배터리를 조금이라도 아끼려면 끄세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laat de led van de node om de paar seconden knipperen om te laten zien dat hij werkt. Zet dit uit om hem donker te houden of wat batterij te sparen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dioda LED węzła mruga co kilka sekund, pokazując, że działa. Wyłącz, aby było ciemno lub by oszczędzić trochę baterii."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pisca o LED do nó a cada poucos segundos para mostrar que ele está funcionando. Desative para mantê-lo apagado ou economizar um pouco de bateria."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faz piscar o LED do nó a cada poucos segundos para mostrar que está a funcionar. Desative para o manter apagado ou poupar um pouco de bateria."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мигает светодиодом узла каждые несколько секунд, показывая, что он работает. Выключите, чтобы узел не светился или чтобы немного сэкономить батарею."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blinkar nodens lysdiod med några sekunders mellanrum för att visa att den är igång. Stäng av för att hålla den släckt eller spara lite batteri."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "กะพริบไฟ LED ของโหนดทุกๆ ไม่กี่วินาทีเพื่อแสดงว่ากำลังทำงานอยู่ ปิดไว้หากไม่ต้องการให้มีแสงหรือเพื่อประหยัดแบตเตอรี่เล็กน้อย"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çalıştığını göstermek için düğümün LED'ini birkaç saniyede bir yakıp söndürür. Karanlıkta kalması veya biraz pil tasarrufu için kapat."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Блимає світлодіодом вузла кожні кілька секунд, показуючи, що він працює. Вимкніть, щоб вузол не світився або щоб трохи заощадити батарею."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nháy đèn LED của node vài giây một lần để cho biết node đang chạy. Tắt đi để node không phát sáng hoặc tiết kiệm chút pin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每隔几秒闪烁一次节点的 LED，表示它正在运行。关闭后可保持黑暗，或略微节省电量。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每隔幾秒閃一下節點的 LED，表示它正在運作。關閉可讓它保持不亮，也能稍微省電。"
          }
        }
      }
    },
