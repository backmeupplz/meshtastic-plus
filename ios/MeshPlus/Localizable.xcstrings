    "Turn the node on and keep it close. Devices you already have aren't listed." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شغّل العقدة وأبقِها قريبة. الأجهزة المضافة مسبقًا لا تظهر في القائمة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schalte den Knoten ein und halte ihn in der Nähe. Bereits hinzugefügte Geräte werden nicht angezeigt."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turn the node on and keep it close. Devices you already have aren't listed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enciende el nodo y mantenlo cerca. Los dispositivos que ya tienes no aparecen."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enciende el nodo y mantenlo cerca. Los dispositivos que ya tienes no aparecen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allumez le nœud et gardez-le à proximité. Les appareils déjà ajoutés n'apparaissent pas."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नोड चालू करें और पास रखें। जो डिवाइस पहले से जुड़े हैं, वे यहाँ नहीं दिखते।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nyalakan node dan dekatkan. Perangkat yang sudah Anda miliki tidak tercantum."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accendi il nodo e tienilo vicino. I dispositivi che hai già non sono elencati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ノードの電源を入れて近くに置いてください。追加済みのデバイスは表示されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "노드를 켜고 가까이 두세요. 이미 추가한 기기는 표시되지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zet de node aan en houd hem dichtbij. Apparaten die je al hebt, staan hier niet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Włącz węzeł i trzymaj go blisko. Urządzenia, które już masz, nie są tu wymienione."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ligue o nó e mantenha-o por perto. Dispositivos que você já tem não aparecem na lista."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ligue o nó e mantenha-o por perto. Os dispositivos que já tem não aparecem na lista."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включите узел и держите его рядом. Уже добавленные устройства здесь не показываются."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slå på noden och håll den nära. Enheter du redan har visas inte."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เปิดโหนดและวางไว้ใกล้ๆ อุปกรณ์ที่คุณมีอยู่แล้วจะไม่แสดงในรายการ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Düğümü aç ve yakında tut. Zaten eklediğin cihazlar listelenmez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Увімкніть вузол і тримайте його поруч. Уже додані пристрої тут не показано."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hãy bật node và để gần. Các thiết bị bạn đã có sẽ không được liệt kê."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请打开节点并放在附近。已添加的设备不会列出。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請開啟節點並放在附近。已加入的裝置不會列出。"
          }
        }
      }
    },
    "Turns the screen upside down, for cases that mount the board the other way." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يقلب الشاشة رأسًا على عقب، للعُلب التي تُركَّب فيها اللوحة بالاتجاه المعاكس."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dreht das Display um 180°, für Gehäuse, in denen das Board andersherum sitzt."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turns the screen upside down, for cases that mount the board the other way."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gira la pantalla 180°, para carcasas que montan la placa al revés."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gira la pantalla 180°, para carcasas que montan la placa al revés."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retourne l'affichage, pour les boîtiers qui montent la carte à l'envers."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "स्क्रीन को उल्टा कर देता है, उन केस के लिए जिनमें बोर्ड उल्टी तरफ़ लगा होता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Membalik layar, untuk casing yang memasang board dengan arah terbalik."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Capovolge lo schermo, per i case che montano la scheda al contrario."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ボードを逆向きに取り付けるケース用に、画面を上下反転します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "보드를 반대 방향으로 장착하는 케이스를 위해 화면을 위아래로 뒤집습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zet het scherm op zijn kop, voor behuizingen waarin het bord andersom zit."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obraca ekran do góry nogami – dla obudów, w których płytka jest zamontowana odwrotnie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vira a tela de cabeça para baixo, para cases que montam a placa ao contrário."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vira o ecrã ao contrário, para caixas que montam a placa ao contrário."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Переворачивает изображение на экране — для корпусов, в которых плата установлена наоборот."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vänder skärmen upp och ned, för fodral där kortet sitter åt andra hållet."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "กลับหน้าจอหัวลง สำหรับเคสที่ติดตั้งบอร์ดกลับด้าน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kartı ters yönde yerleştiren kasalar için ekranı baş aşağı çevirir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перевертає зображення на екрані — для корпусів, у яких плату встановлено навпаки."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lật ngược màn hình, dành cho vỏ hộp lắp bo mạch theo chiều ngược lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将屏幕上下翻转，适用于板子反向安装的外壳。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將螢幕上下翻轉，適用於板子反向安裝的外殼。"
          }
        }
      }
    },
