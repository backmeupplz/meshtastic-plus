    "Ignores messages that reached the mesh from the internet through MQTT gateways." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتجاهل الرسائل التي وصلت إلى الشبكة من الإنترنت عبر بوابات MQTT."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ignoriert Nachrichten, die über MQTT-Gateways aus dem Internet ins Mesh gelangt sind."
          }
        },
        "en-GB" : {
