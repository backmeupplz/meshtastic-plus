    "Signal's weak up here but I read you." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الإشارة ضعيفة هنا لكني أسمعك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Signal ist schwach hier oben, aber ich hör dich."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Signal's weak up here but I read you."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquí arriba hay poca señal, pero te recibo."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquí arriba hay poca señal, pero te copio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le signal est faible ici, mais je te reçois."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यहाँ ऊपर सिग्नल कमज़ोर है, पर तुम्हारी बात साफ़ आ रही है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sinyal di atas sini lemah, tapi pesanmu masuk."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quassù il segnale è debole, ma ti ricevo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ここは電波弱いけど、ちゃんと聞こえてるよ。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "여기는 신호가 약하지만 잘 들려요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Signaal is zwak hierboven, maar ik hoor je."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sygnał tu słaby, ale cię słyszę."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O sinal está fraco aqui em cima, mas estou te ouvindo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O sinal está fraco cá em cima, mas estou a ouvir-te."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сигнал тут наверху слабый, но я тебя слышу."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svag signal här uppe, men jag hör dig."
          }
