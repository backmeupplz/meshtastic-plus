    "You haven't blocked anyone. To block someone, press and hold one of their messages, or open them in Nodes." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم تحظر أي شخص. لحظر شخص ما، اضغط مطولًا على إحدى رسائله، أو افتحه في «العُقد»."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast niemanden blockiert. Um jemanden zu blockieren, halte eine seiner Nachrichten gedrückt oder öffne ihn unter „Knoten“."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You haven't blocked anyone. To block someone, press and hold one of their messages, or open them in Nodes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No has bloqueado a nadie. Para bloquear a alguien, mantén pulsado uno de sus mensajes o ábrelo en Nodos."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No has bloqueado a nadie. Para bloquear a alguien, mantén presionado uno de sus mensajes o ábrelo en Nodos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous n'avez bloqué personne. Pour bloquer quelqu'un, maintenez le doigt sur l'un de ses messages ou ouvrez son profil dans Nœuds."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपने किसी को ब्लॉक नहीं किया है। किसी को ब्लॉक करने के लिए उसका कोई मैसेज दबाकर रखें, या उसे ‘नोड’ में खोलें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda belum memblokir siapa pun. Untuk memblokir seseorang, tekan lama salah satu pesannya, atau buka orang tersebut di Node."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non hai bloccato nessuno. Per bloccare qualcuno, tieni premuto uno dei suoi messaggi o apri il suo profilo in Nodi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ブロックしている人はいません。ブロックするには、相手のメッセージを長押しするか、「ノード」で相手を開いてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "차단한 사람이 없습니다. 차단하려면 상대방의 메시지를 길게 누르거나 노드에서 상대를 여세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je hebt niemand geblokkeerd. Om iemand te blokkeren, houd je een van zijn berichten ingedrukt of open je hem in Nodes."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nikogo nie zablokowano. Aby kogoś zablokować, przytrzymaj jedną z jego wiadomości albo otwórz go w zakładce Węzły."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você não bloqueou ninguém. Para bloquear alguém, toque e segure uma das mensagens da pessoa ou abra o perfil dela em Nós."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não bloqueou ninguém. Para bloquear alguém, mantenha premida uma das mensagens dessa pessoa ou abra o perfil dela em Nós."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы никого не заблокировали. Чтобы заблокировать человека, нажмите и удерживайте одно из его сообщений или откройте его в разделе «Узлы»."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du har inte blockerat någon. Om du vill blockera någon trycker du länge på ett av personens meddelanden eller öppnar personen under Noder."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณยังไม่ได้บล็อกใคร หากต้องการบล็อกใคร ให้แตะข้อความของเขาค้างไว้ หรือเปิดดูเขาในแท็บโหนด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kimseyi engellemedin. Birini engellemek için mesajlarından birine basılı tut veya kişiyi Düğümler'de aç."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ви нікого не заблокували. Щоб заблокувати людину, натисніть і утримуйте одне з її повідомлень або відкрийте її в розділі «Вузли»."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn chưa chặn ai. Để chặn ai đó, hãy nhấn giữ một tin nhắn của họ, hoặc mở họ trong mục Node."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你还没有屏蔽任何人。要屏蔽某人，请长按其任意一条消息，或在“节点”中打开对方。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你尚未封鎖任何人。若要封鎖某人，請按住對方的任一則訊息，或在「節點」中開啟對方。"
          }
        }
      }
    },
