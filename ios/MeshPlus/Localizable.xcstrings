    "Powers the node off this long after it's unplugged from USB or solar. Never keeps it running on battery." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُطفئ العقدة بعد هذه المدة من فصلها عن USB أو الطاقة الشمسية. مع «أبدًا» تبقى تعمل على البطارية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schaltet den Knoten so lange nach dem Trennen von USB oder Solar aus. Bei „Nie“ läuft er im Akkubetrieb weiter."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Powers the node off this long after it's unplugged from USB or solar. Never keeps it running on battery."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apaga el nodo pasado este tiempo desde que se desconecta del USB o de la placa solar. Con Nunca, sigue funcionando con batería."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apaga el nodo pasado este tiempo desde que se desconecta del USB o del panel solar. Con Nunca, sigue funcionando con batería."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Éteint le nœud après ce délai une fois débranché de l'USB ou du panneau solaire. Jamais le laisse fonctionner sur batterie."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "USB या सोलर से हटाए जाने के इतनी देर बाद नोड बंद हो जाता है। ‘कभी नहीं’ चुनने पर यह बैटरी पर चलता रहता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mematikan node setelah selama ini dilepas dari USB atau panel surya. Tidak pernah berarti node tetap menyala dengan baterai."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spegne il nodo dopo questo tempo da quando viene scollegato dall'USB o dal pannello solare. Mai lo tiene acceso a batteria."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "USBやソーラーから外れてから指定した時間が経つと、ノードの電源を切ります。「しない」を選ぶとバッテリーで動作し続けます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "USB나 태양광 전원에서 분리된 후 이 시간이 지나면 노드를 끕니다. '안 함'을 선택하면 배터리로 계속 작동합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schakelt de node zo lang na het loskoppelen van USB of zonnepaneel uit. Bij ‘Nooit’ blijft hij op batterij draaien."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyłącza węzeł po tym czasie od odłączenia od USB lub panelu słonecznego. Opcja Nigdy pozostawia go włączonego na baterii."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desliga o nó depois desse tempo sem energia USB ou solar. Nunca o mantém funcionando na bateria."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desliga o nó ao fim deste tempo depois de ser desligado da alimentação USB ou solar. Nunca o mantém a funcionar com a bateria."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выключает узел через указанное время после отключения от USB или солнечной панели. «Никогда» — продолжать работу от батареи."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stänger av noden så här lång tid efter att den kopplats bort från USB eller solpanel. Aldrig låter den fortsätta på batteri."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ปิดโหนดหลังจากถอดออกจาก USB หรือแผงโซลาร์เป็นเวลาเท่านี้ ไม่เลย จะให้โหนดทำงานต่อด้วยแบตเตอรี่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "USB'den veya güneş panelinden ayrıldıktan bu süre sonra düğümü kapatır. Hiçbir zaman seçeneği düğümü pille çalışır durumda tutar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вимикає вузол через вказаний час після від’єднання від USB або сонячної панелі. «Ніколи» — продовжувати роботу від батареї."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tắt node sau khoảng thời gian này kể từ khi rút khỏi USB hoặc pin mặt trời. Không bao giờ sẽ giữ node chạy bằng pin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "节点断开 USB 或太阳能供电后，经过此时长自动关机。选择“永不”则会一直用电池运行。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "節點拔除 USB 或太陽能供電後，經過這段時間會自動關機。選擇「永不」則會持續以電池運作。"
          }
        }
      }
    },
    "Press and hold any message to report it or block its sender. You can also block someone from their profile in Nodes." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضغط مطولًا على أي رسالة للإبلاغ عنها أو حظر مُرسلها. يمكنك أيضًا حظر أي شخص من ملفه في «العُقد»."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte eine Nachricht gedrückt, um sie zu melden oder den Absender zu blockieren. Du kannst jemanden auch über sein Profil unter „Knoten“ blockieren."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Press and hold any message to report it or block its sender. You can also block someone from their profile in Nodes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén pulsado cualquier mensaje para denunciarlo o bloquear a quien lo envió. También puedes bloquear a alguien desde su perfil en Nodos."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén presionado cualquier mensaje para reportarlo o bloquear a quien lo envió. También puedes bloquear a alguien desde su perfil en Nodos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maintenez le doigt sur un message pour le signaler ou bloquer son expéditeur. Vous pouvez aussi bloquer quelqu'un depuis son profil dans Nœuds."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "किसी मैसेज को रिपोर्ट करने या उसके भेजने वाले को ब्लॉक करने के लिए उसे दबाकर रखें। आप ‘नोड’ में किसी की प्रोफ़ाइल से भी उसे ब्लॉक कर सकते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tekan lama pesan mana pun untuk melaporkannya atau memblokir pengirimnya. Anda juga bisa memblokir seseorang dari profilnya di Node."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tieni premuto un messaggio per segnalarlo o bloccarne il mittente. Puoi anche bloccare qualcuno dal suo profilo in Nodi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メッセージを長押しすると、そのメッセージを報告したり、送信者をブロックしたりできます。「ノード」で相手のプロフィールからブロックすることもできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "메시지를 길게 눌러 신고하거나 보낸 사람을 차단할 수 있습니다. 노드에서 상대의 프로필을 열어 차단할 수도 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houd een bericht ingedrukt om het te melden of de afzender te blokkeren. Je kunt iemand ook blokkeren vanuit zijn profiel in Nodes."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przytrzymaj dowolną wiadomość, aby ją zgłosić lub zablokować nadawcę. Możesz też zablokować kogoś z jego profilu w zakładce Węzły."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque e segure qualquer mensagem para denunciá-la ou bloquear o remetente. Você também pode bloquear alguém pelo perfil dele em Nós."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenha premida qualquer mensagem para a denunciar ou bloquear o remetente. Também pode bloquear alguém a partir do perfil em Nós."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажмите и удерживайте любое сообщение, чтобы пожаловаться на него или заблокировать отправителя. Заблокировать человека можно и из его профиля в разделе «Узлы»."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryck länge på ett meddelande för att anmäla det eller blockera avsändaren. Du kan också blockera någon från personens profil under Noder."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แตะข้อความใดก็ได้ค้างไว้เพื่อรายงานหรือบล็อกผู้ส่ง คุณยังบล็อกใครก็ได้จากโปรไฟล์ของเขาในแท็บโหนด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir mesajı bildirmek veya göndereni engellemek için mesaja basılı tut. Birini Düğümler'deki profilinden de engelleyebilirsin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Натисніть і утримуйте будь-яке повідомлення, щоб поскаржитися на нього або заблокувати відправника. Заблокувати людину можна й з її профілю в розділі «Вузли»."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhấn giữ một tin nhắn bất kỳ để báo cáo hoặc chặn người gửi. Bạn cũng có thể chặn ai đó từ hồ sơ của họ trong mục Node."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "长按任意消息即可举报或屏蔽发送者。你也可以在“节点”中从对方的资料页屏蔽。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按住任一則訊息即可檢舉，或封鎖傳送者。你也可以在「節點」中，從對方的個人資料封鎖對方。"
          }
        }
      }
    },
