        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ข้างบนนี้สัญญาณอ่อน แต่ยังได้ยินชัด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Burada sinyal zayıf ama seni duyuyorum."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сигнал тут нагорі слабкий, але я тебе чую."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trên này sóng yếu nhưng mình vẫn nghe rõ."
          }
