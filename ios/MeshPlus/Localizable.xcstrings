    "Changing this can drop the Bluetooth connection while the node restarts." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قد يؤدي تغيير هذا الإعداد إلى قطع اتصال Bluetooth أثناء إعادة تشغيل العقدة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Änderung kann die Bluetooth-Verbindung trennen, während der Knoten neu startet."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Changing this can drop the Bluetooth connection while the node restarts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambiar esto puede cortar la conexión Bluetooth mientras el nodo se reinicia."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambiar esto puede cortar la conexión Bluetooth mientras el nodo se reinicia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce changement peut couper la connexion Bluetooth pendant le redémarrage du nœud."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इसे बदलने से नोड के रीस्टार्ट होते समय Bluetooth कनेक्शन टूट सकता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mengubah ini bisa memutus koneksi Bluetooth saat node dimulai ulang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa modifica può interrompere la connessione Bluetooth mentre il nodo si riavvia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これを変更すると、ノードの再起動中にBluetooth接続が切れることがあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 설정을 변경하면 노드가 재시작되는 동안 Bluetooth 연결이 끊길 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als je dit wijzigt, kan de Bluetooth-verbinding wegvallen terwijl de node herstart."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zmiana może zerwać połączenie Bluetooth podczas ponownego uruchamiania węzła."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alterar isto pode derrubar a conexão Bluetooth enquanto o nó reinicia."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alterar esta opção pode interromper a ligação Bluetooth enquanto o nó reinicia."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При изменении этой настройки Bluetooth-соединение может прерваться, пока узел перезагружается."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om du ändrar detta kan Bluetooth-anslutningen brytas medan noden startar om."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การเปลี่ยนค่านี้อาจทำให้การเชื่อมต่อ Bluetooth หลุดขณะที่โหนดรีสตาร์ท"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bunu değiştirmek, düğüm yeniden başlarken Bluetooth bağlantısını koparabilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Після зміни цього параметра з’єднання Bluetooth може перерватися, поки вузол перезавантажується."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thay đổi mục này có thể làm mất kết nối Bluetooth trong lúc node khởi động lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
