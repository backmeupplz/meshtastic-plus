        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Framme vid andra sjön. Ingen mobiltäckning alls här, men meshen funkar fortfarande 🙂"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "มาถึงทะเลสาบที่สองแล้ว ที่นี่ไม่มีสัญญาณมือถือเลย แต่เมชยังใช้ได้ 🙂"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İkinci göle vardım. Burada hiç şebeke yok ama ağ hâlâ çalışıyor 🙂"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дійшли до другого озера. Мобільного зв’язку тут нуль, а Meshtastic працює 🙂"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đã tới hồ thứ hai. Ở đây không có sóng điện thoại, nhưng mạng mesh vẫn chạy 🙂"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "到第二个湖了。这里手机一点信号都没有，Mesh 照样能用 🙂"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "到第二個湖了。這裡完全沒有手機訊號，Mesh 還是能用 🙂"
          }
        }
      }
    },
    "Makes the receiver a bit more sensitive on SX126x radios (most modern boards), for slightly more power use." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يجعل جهاز الاستقبال أكثر حساسية قليلًا في أجهزة راديو SX126x (معظم اللوحات الحديثة)، مقابل استهلاك أعلى قليلًا للطاقة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Macht den Empfänger bei SX126x-Funkchips (die meisten modernen Boards) etwas empfindlicher, bei leicht höherem Stromverbrauch."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Makes the receiver a bit more sensitive on SX126x radios (most modern boards), for slightly more power use."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hace el receptor un poco más sensible en radios SX126x (la mayoría de las placas modernas), a cambio de un consumo algo mayor."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hace el receptor un poco más sensible en radios SX126x (la mayoría de las placas modernas), a cambio de un consumo algo mayor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rend le récepteur un peu plus sensible sur les radios SX126x (la plupart des cartes récentes), au prix d'une consommation légèrement plus élevée."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SX126x रेडियो (ज़्यादातर आधुनिक बोर्ड) पर रिसीवर को थोड़ा ज़्यादा संवेदनशील बनाता है, बदले में थोड़ी ज़्यादा बिजली खर्च होती है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Membuat penerima sedikit lebih sensitif pada radio SX126x (sebagian besar board modern), dengan konsumsi daya sedikit lebih tinggi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rende il ricevitore un po' più sensibile sulle radio SX126x (la maggior parte delle schede recenti), con un consumo leggermente maggiore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SX126x無線チップ（最近のほとんどのボード）で受信感度を少し上げます。消費電力はわずかに増えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SX126x 무선 칩(대부분의 최신 보드)에서 수신 감도를 약간 높입니다. 전력 소모가 조금 늘어납니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maakt de ontvanger iets gevoeliger op SX126x-radio's (de meeste moderne borden), tegen iets meer stroomverbruik."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zwiększa nieco czułość odbiornika w radiach SX126x (większość nowych płytek) kosztem nieco większego poboru energii."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deixa o receptor um pouco mais sensível em rádios SX126x (a maioria das placas modernas), com um consumo de energia um pouco maior."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Torna o recetor um pouco mais sensível em rádios SX126x (a maioria das placas modernas), com um consumo ligeiramente maior."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Немного повышает чувствительность приёмника на радиомодулях SX126x (большинство современных плат) ценой чуть большего энергопотребления."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gör mottagaren lite känsligare på SX126x-radio (de flesta moderna kort), mot något högre strömförbrukning."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ทำให้ภาครับไวขึ้นเล็กน้อยบนวิทยุ SX126x (บอร์ดรุ่นใหม่ส่วนใหญ่) แลกกับการใช้พลังงานเพิ่มขึ้นเล็กน้อย"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SX126x telsizlerde (çoğu modern kart) alıcıyı biraz daha hassas yapar; güç tüketimi biraz artar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Трохи підвищує чутливість приймача на радіомодулях SX126x (більшість сучасних плат) ціною трохи більшого енергоспоживання."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giúp bộ thu nhạy hơn một chút trên radio SX126x (hầu hết bo mạch hiện đại), đổi lại tốn thêm chút điện."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 SX126x 无线电芯片（大多数新款板子）上略微提高接收灵敏度，功耗会稍有增加。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 SX126x 無線電晶片（大多數新款板子）上稍微提高接收靈敏度，耗電量會略微增加。"
          }
        }
      }
    },
