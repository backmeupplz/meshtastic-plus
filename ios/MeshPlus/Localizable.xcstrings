    "Shows the time as 1:00 PM instead of 13:00 on the node's screen." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعرض الوقت على شاشة العقدة بصيغة 1:00 م بدلًا من 13:00."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt die Uhrzeit auf dem Display des Knotens als 1:00 PM statt 13:00 an."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shows the time as 1:00 PM instead of 13:00 on the node's screen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra la hora como 1:00 PM en vez de 13:00 en la pantalla del nodo."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra la hora como 1:00 PM en vez de 13:00 en la pantalla del nodo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affiche l'heure au format 1:00 PM au lieu de 13:00 sur l'écran du nœud."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नोड की स्क्रीन पर समय 13:00 की जगह 1:00 PM के रूप में दिखाता है।"
