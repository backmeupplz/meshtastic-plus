        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika iOS meminta PIN, ketik PIN yang tampil di layar node. Tidak ada layar? Biasanya 123456."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se iOS chiede un PIN, inserisci quello mostrato sullo schermo del nodo. Niente schermo? Di solito è 123456."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOSでPINを求められたら、ノードの画面に表示されているPINを入力してください。画面がない場合は、通常123456です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS에서 PIN을 요청하면 노드 화면에 표시된 PIN을 입력하세요. 화면이 없다면 보통 123456입니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als iOS om een pincode vraagt, typ dan de code die op het scherm van de node staat. Geen scherm? Meestal is het 123456."
          }
        },
        "pl" : {
          "stringUnit" : {
