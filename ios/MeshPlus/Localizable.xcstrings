    "Connects the node to a Wi-Fi network, for internet gateways. On ESP32 boards Wi-Fi turns Bluetooth off." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يربط العقدة بشبكة Wi-Fi، لاستخدامها كبوابة إلى الإنترنت. في لوحات ESP32 يؤدي تشغيل Wi-Fi إلى إيقاف Bluetooth."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbindet den Knoten mit einem WLAN, für Internet-Gateways. Auf ESP32-Boards schaltet WLAN Bluetooth aus."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connects the node to a Wi-Fi network, for internet gateways. On ESP32 boards Wi-Fi turns Bluetooth off."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conecta el nodo a una red Wi-Fi, para usarlo como pasarela a internet. En las placas ESP32, el Wi-Fi desactiva el Bluetooth."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conecta el nodo a una red Wi-Fi, para usarlo como puerta de enlace a internet. En las placas ESP32, el Wi-Fi desactiva el Bluetooth."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connecte le nœud à un réseau Wi-Fi, pour servir de passerelle internet. Sur les cartes ESP32, le Wi-Fi désactive le Bluetooth."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इंटरनेट गेटवे के लिए नोड को Wi-Fi नेटवर्क से जोड़ता है। ESP32 बोर्ड पर Wi-Fi चालू करने से Bluetooth बंद हो जाता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menghubungkan node ke jaringan Wi-Fi, untuk gateway internet. Di board ESP32, Wi-Fi akan mematikan Bluetooth."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Collega il nodo a una rete Wi-Fi, per fare da gateway internet. Sulle schede ESP32 il Wi-Fi disattiva il Bluetooth."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "インターネットゲートウェイとして使うために、ノードをWi-Fiネットワークに接続します。ESP32ボードではWi-Fiを使うとBluetoothがオフになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "인터넷 게이트웨이로 쓸 수 있도록 노드를 Wi-Fi 네트워크에 연결합니다. ESP32 보드에서는 Wi-Fi를 켜면 Bluetooth가 꺼집니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbindt de node met een wifinetwerk, voor internetgateways. Op ESP32-borden schakelt wifi Bluetooth uit."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Łączy węzeł z siecią Wi-Fi – dla bramek internetowych. Na płytkach ESP32 Wi-Fi wyłącza Bluetooth."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conecta o nó a uma rede Wi-Fi, para gateways de internet. Nas placas ESP32, o Wi-Fi desativa o Bluetooth."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liga o nó a uma rede Wi-Fi, para gateways de internet. Nas placas ESP32, o Wi-Fi desativa o Bluetooth."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подключает узел к сети Wi-Fi — для интернет-шлюзов. На платах ESP32 Wi-Fi отключает Bluetooth."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ansluter noden till ett Wi-Fi-nätverk, för internetgateways. På ESP32-kort stänger Wi-Fi av Bluetooth."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เชื่อมต่อโหนดกับเครือข่าย Wi-Fi สำหรับใช้เป็นเกตเวย์อินเทอร์เน็ต บนบอร์ด ESP32 การเปิด Wi-Fi จะปิด Bluetooth"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Düğümü bir Wi-Fi ağına bağlar; internet ağ geçitleri içindir. ESP32 kartlarda Wi-Fi, Bluetooth'u kapatır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Під’єднує вузол до мережі Wi-Fi — для інтернет-шлюзів. На платах ESP32 Wi-Fi вимикає Bluetooth."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kết nối node với mạng Wi-Fi, dùng cho cổng kết nối internet. Trên bo mạch ESP32, bật Wi-Fi sẽ tắt Bluetooth."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将节点连接到 Wi-Fi 网络，用作互联网网关。在 ESP32 板上，开启 Wi-Fi 会关闭 Bluetooth。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將節點連上 Wi-Fi 網路，作為網際網路閘道器使用。在 ESP32 板上，開啟 Wi-Fi 會關閉藍牙。"
          }
        }
      }
    },
