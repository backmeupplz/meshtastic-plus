            "value" : "Jeśli iOS poprosi o PIN, wpisz ten z ekranu węzła. Nie ma ekranu? Zwykle to 123456."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se o iOS pedir um PIN, digite o que aparece na tela do nó. Sem tela? Geralmente é 123456."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
