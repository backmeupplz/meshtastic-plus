    "Also shares your location early after you've moved a good distance, and skips updates while you stay put." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يشارك موقعك أيضًا قبل موعده عندما تقطع مسافة كافية، ويتخطى التحديثات ما دمت في مكانك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teilt deinen Standort außerdem früher, wenn du ein gutes Stück unterwegs warst, und lässt Updates aus, solange du an einem Ort bleibst."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Also shares your location early after you've moved a good distance, and skips updates while you stay put."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "También comparte tu ubicación antes de tiempo si te has desplazado bastante, y omite actualizaciones mientras sigues en el mismo sitio."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "También comparte tu ubicación antes de tiempo si te moviste bastante, y omite actualizaciones mientras sigues en el mismo lugar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Partage aussi votre position plus tôt si vous avez parcouru une bonne distance, et n'envoie rien tant que vous restez sur place."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "काफ़ी दूरी तय करने पर आपकी लोकेशन समय से पहले भी शेयर करता है, और एक जगह रुके रहने पर अपडेट नहीं भेजता।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Juga membagikan lokasi Anda lebih awal setelah Anda berpindah cukup jauh, dan melewatkan pembaruan selama Anda diam di tempat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Condivide la posizione anche in anticipo quando ti sei spostato parecchio, e salta gli aggiornamenti finché resti fermo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "大きく移動したときは早めに位置情報を共有し、同じ場所にとどまっている間は更新を省略します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "많이 이동하면 위치를 더 일찍 공유하고, 한곳에 머무는 동안에는 업데이트를 건너뜁니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deelt je locatie ook eerder als je een flink stuk bent verplaatst, en slaat updates over zolang je op je plek blijft."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Udostępnia też lokalizację wcześniej, gdy przemieścisz się na większą odległość, i pomija aktualizacje, gdy stoisz w miejscu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Também compartilha sua localização antes do previsto quando você se desloca bastante e pula atualizações enquanto você está parado."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Também partilha a sua localização mais cedo quando se desloca uma boa distância e salta atualizações enquanto está parado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кроме того, отправляет местоположение раньше, если вы заметно переместились, и пропускает обновления, пока вы стоите на месте."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delar även din position tidigare när du har förflyttat dig en bra bit, och hoppar över uppdateringar medan du står still."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แชร์ตำแหน่งให้เร็วขึ้นเมื่อคุณเคลื่อนที่ไปไกลพอสมควร และข้ามการอัปเดตเมื่อคุณอยู่กับที่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayrıca epey yol aldığında konumunu erkenden paylaşır, yerinde durduğun sürece de güncelleme göndermez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Крім того, надсилає місцезнаходження раніше, якщо ви помітно перемістилися, і пропускає оновлення, поки ви на місці."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đồng thời chia sẻ vị trí sớm hơn khi bạn đã di chuyển một quãng khá xa, và bỏ qua cập nhật khi bạn đứng yên."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "移动较远距离后会提前分享位置，原地不动时则跳过更新。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "移動一段距離後會提早分享你的位置，停留原地時則略過更新。"
          }
        }
      }
    },
